{
	"files.exclude": {
		"**/.git": true,
		"**/.DS_Store": true
	},
	"editor.fontSize": 15,
	"terminal.integrated.fontSize": 15,
	"workbench.tree.renderIndentGuides": "none",
	"git.autorefresh": true,
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"emmet.showExpandedAbbreviation": "never"
}
