# Managed by Ansible (log-limits role)
# Size-capped rotation for rsyslog's files. This replaces the stock
# /etc/logrotate.d/rsyslog, which the role removes so logrotate does not see
# duplicate entries.
{% for log in logrotate_managed_logs %}
{{ log }}
{% endfor %}
{
    rotate {{ logrotate_rotate_count }}
    daily
    maxsize {{ logrotate_max_size }}
    compress
    delaycompress
    missingok
    notifempty
    create 640 {{ log_owner }} {{ log_group }}
    su {{ log_owner }} {{ log_group }}
    sharedscripts
    postrotate
        if [ -x /usr/lib/rsyslog/rsyslog-rotate ]; then
            /usr/lib/rsyslog/rsyslog-rotate
        fi
    endscript
}
