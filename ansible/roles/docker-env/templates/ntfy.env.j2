NTFY_AUTH_USERS='{{ ntfy_admin_user }}:{{ ntfy_admin_password_hash }}:admin'
NTFY_AUTH_TOKENS='{{ ntfy_admin_user }}:{{ ntfy_admin_token }}:Rainhold host scripts'
